APP_NAME="Supreme Court Data Visualization"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=${RAILWAY_STATIC_URL}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Railway PostgreSQL Database (preferred for production)
DB_CONNECTION=pgsql
DB_HOST=${PGHOST}
DB_PORT=${PGPORT}
DB_DATABASE=${PGDATABASE}
DB_USERNAME=${PGUSER}
DB_PASSWORD=${PGPASSWORD}

# Alternative: Railway MySQL Database
# DB_CONNECTION=mysql
# DB_HOST=${MYSQLHOST}
# DB_PORT=${MYSQLPORT}
# DB_DATABASE=${MYSQLDATABASE}
# DB_USERNAME=${MYSQLUSER}
# DB_PASSWORD=${MYSQLPASSWORD}

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Railway Redis Configuration
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=${REDIS_HOST}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_PORT=${REDIS_PORT}
REDIS_URL=${REDIS_URL}

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@supreme-court-viz.railway.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Supreme Court Data Visualization Configuration
JUSTIA_API_KEY=${JUSTIA_API_KEY}
OPENAI_API_KEY=${OPENAI_API_KEY}

# Disable Ollama in Railway (not supported in cloud deployment)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
ENABLE_LLM_ANALYSIS=false

# Redis Configuration for Opinion Data
REDIS_OPINION_PREFIX=supreme_court:opinions:
REDIS_CACHE_TTL=3600

# Rate Limiting for API Calls
JUSTIA_RATE_LIMIT_PER_MINUTE=60
JUSTIA_RATE_LIMIT_BURST=10

# Analysis Configuration (cloud-optimized)
ENABLE_PRECEDENTIAL_ANALYSIS=true
ANALYSIS_BATCH_SIZE=50

# Production Configuration
APP_TIMEZONE=UTC
FILAMENT_THEME=default

# Railway-specific optimizations
OCTANE_SERVER=swoole
TELESCOPE_ENABLED=false